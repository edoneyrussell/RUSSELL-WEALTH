# Configure locally; never commit real secrets.
FLASK_SECRET_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
EODHD_API_KEY=
TWELVE_DATA_API_KEY=

# Number of trusted reverse proxies between the visitor and Flask (0 for direct local access).
RW_TRUSTED_PROXY_HOPS=0

# Password reset email delivery (use a domain verified in Resend for all recipients).
RW_RESEND_API_KEY=
RW_VERIFICATION_FROM=Russell Wealth <noreply@your-verified-domain.com>
# Frontend origin used in emailed reset links; use http://127.0.0.1:5173 locally.
RW_PUBLIC_APP_URL=https://russell-wealth.vercel.app
