{
  "python.terminal.useEnvFile": true,
  "python.analysis.extraPaths": [
    "./backend"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/*.py[cod]": true,
    "**/*.db": true,
    "**/*.db-*": true,
    "**/*.sqlite": true,
    "**/*.sqlite3": true,
    "**/.env": true,
    "**/backups": true,
    "**/recovery-checkpoints": true,
    "**/*-backup-*": true,
    "**/*-backups": true,
    "**/*.before*": true,
    "**/*.bak": true,
    "**/*.backup*": true,
    "**/redesign-backups": true,
    "**/mobile-audit": true,
    "**/carbon_package": true,
    "**/frontend/screens": true,
    "**/.DS_Store": true,
    "**/.venv": true,
    "**/russellwealth-env": true,
    "**/*.log": true,
    "**/.env.save": true,
    "**/.env.backup*": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/*.py[cod]": true,
    "**/*.db": true,
    "**/*.db-*": true,
    "**/*.sqlite": true,
    "**/*.sqlite3": true,
    "**/.env": true,
    "**/backups": true,
    "**/recovery-checkpoints": true,
    "**/*-backup-*": true,
    "**/*-backups": true,
    "**/*.before*": true,
    "**/*.bak": true,
    "**/*.backup*": true,
    "**/redesign-backups": true,
    "**/mobile-audit": true,
    "**/carbon_package": true,
    "**/frontend/screens": true,
    "**/.DS_Store": true,
    "**/.venv": true,
    "**/russellwealth-env": true,
    "**/*.log": true,
    "**/.env.save": true,
    "**/.env.backup*": true
  },
  "explorer.compactFolders": true,
  "editor.formatOnSave": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "workbench.tree.indent": 16,
  "editor.rulers": [
    100
  ],
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[css]": {
    "editor.tabSize": 2
  },
  "explorer.sortOrder": "type"
}
